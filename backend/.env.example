# Copy to .env and edit. Never commit the real .env file.
PORT=3000
# Long random string. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
TOKEN_HOURS=8
# Comma-separated list of front-end origins allowed to call the API (use * only for local testing)
CORS_ORIGIN=*
# Set to 1 when running behind a proxy (Render, Railway, Nginx) so rate limits use the real client IP
TRUST_PROXY=0
# Optional: where the JSON database file lives
DATA_FILE=data/db.json
